# Aplicacion
NODE_ENV=development
PORT=3000
AUDITORIA_NAME=auditoria

# BD Auditoria (PostgreSQL). DB_PORT=5436 es el puerto publicado por
# docker-compose.local.yml hacia el host; dentro de la red de compose es 5432.
DB_HOST=localhost
DB_PORT=5436
DB_USER=auditoria
DB_PASSWORD=auditoria
DB_NAME=auditoria

# Muestra las consultas SQL en consola.
DB_LOGGING=false
